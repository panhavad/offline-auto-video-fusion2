# Copy this file to .env and adjust the values for your machine.
# .env is git-ignored, so local port changes never end up in a commit.
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)

# Host port for the production-like nginx container (docker compose up -d app).
# Open the app at http://localhost:$APP_PORT
APP_PORT=8080

# Port for the Vite dev server, used by both `npm run dev` and the
# `dev` compose service (host and container side are kept identical).
DEV_PORT=5173

# Port for `npm run preview`, which serves the built dist/ locally.
PREVIEW_PORT=4173

# ---------------------------------------------------------------------------
# Automatic updates (docker compose --profile autoupdate up -d updater)
# The updater watches the git remote and rebuilds + restarts the app container
# whenever the tracked branch gets a new commit. All values below are optional.
# ---------------------------------------------------------------------------

# Remote and branch to follow.
UPDATE_REMOTE=origin
UPDATE_BRANCH=main

# Seconds between two checks of the remote.
UPDATE_INTERVAL=300

# Compose services rebuilt and restarted after a successful pull (space separated).
UPDATE_SERVICES=app

# Delete the images a rebuild leaves dangling, so the disk does not fill up.
UPDATE_PRUNE=true

# true discards local modifications in the checkout instead of skipping the
# update. Leave it false unless the deployment clone is strictly read-only.
UPDATE_FORCE_RESET=false

# true rebuilds once when the updater starts, even without a new commit.
UPDATE_DEPLOY_ON_START=false

# Time zone used for the updater's log timestamps.
TZ=UTC
